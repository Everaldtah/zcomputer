    {
      "id": "z-alpine-desktop-x86",
      "name": "Z Alpine Desktop (x86)",
      "summary": "Alpine Linux 3.22 with an XFCE desktop, prepared for agents (xdotool, scrot, zguest). Starts in about a second from a saved state.",
      "kind": "instantStart",
      "recommended": true,
      "defaultMemoryMB": 512,
      "vgaMemoryMB": 8,
      "screen": { "width": 1024, "height": 768 },
      "manifestURL": "https://github.com/Everaldtah/zcomputer/releases/download/images-v1/manifest.json",
      "manifestImageID": "z-alpine-desktop-x86",
      "files": [],
      "serialLogin": { "user": "z", "password": "z" },
      "network": "fetch",
      "nic": "virtio",
      "acpi": false,
      "enable9p": true,
      "emulatorCommit": "cc37f35c43bf14865d74ad76879ecf9410f69eb1",
      "homepage": "https://github.com/Everaldtah/zcomputer/blob/main/docs/IMAGES-X86.md",
      "license": "Alpine Linux packages (various open-source licences)",
      "notes": [
        "Built by .github/workflows/images.yml; the files and their sha256s come from manifest.json of the images-v1 release.",
        "The state restores only with this exact v86 build, 512 MB RAM, 8 MB VGA memory, virtio-net, a 9p device and the pristine disk image.",
        "User z / password z, passwordless sudo; ttyS0 is a logged-in bash in the saved state."
      ]
    },
    {
      "id": "alpine-virt-x86",
      "name": "Alpine Linux 3.22 virt (x86 ISO)",
      "summary": "Small text-mode Alpine live system and installer (50 MB). Boots to a root login on the serial console in about a minute.",
      "kind": "iso",
      "recommended": false,
      "defaultMemoryMB": 256,
      "vgaMemoryMB": 8,
      "files": [
        {
          "role": "cdrom",
          "name": "alpine-virt-3.22.7-x86.iso",
          "url": "https://dl-cdn.alpinelinux.org/alpine/v3.22/releases/x86/alpine-virt-3.22.7-x86.iso",
          "sizeBytes": 52428800,
          "sha256": "569ad8cef1d6d3a3a6024f28ee94ea156974b32437240f2b217c56a99fbb6296",
          "compression": "none"
        }
      ],
      "serialLogin": { "user": "root", "password": "" },
      "bootAssist": {
        "waitForScreenText": "boot:",
        "typeText": "virt console=tty0 console=ttyS0,115200\n",
        "timeoutSeconds": 120
      },
      "network": "fetch",
      "nic": "virtio",
      "acpi": false,
      "enable9p": true,
      "homepage": "https://alpinelinux.org/downloads/",
      "license": "Alpine Linux packages (various open-source licences)",
      "notes": [
        "The boot assist adds console=ttyS0 at the syslinux boot: prompt so the kernel, OpenRC and a getty use the serial console.",
        "Log in as root without a password; setup-alpine installs to a disk."
      ]
    },
