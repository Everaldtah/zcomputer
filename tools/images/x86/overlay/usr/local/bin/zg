#!/usr/bin/env python3
"""zg - send one request to the local zguest agent and print the response.

  zg ping                      -> {"op":"ping"}
  zg sysinfo
  zg '{"op":"exec","cmd":"uname -a"}'
  zg --png /tmp/s.png screenshot   (writes the PNG, prints the rest of the response)

ZGUEST_ADDR (default 127.0.0.1:5555) and ZG_TIMEOUT (seconds, default 60).
Exit status 0 when the response has "ok": true.
"""
import base64
import json
import os
import socket
import sys


def main(argv):
    png = None
    if len(argv) >= 2 and argv[0] == "--png":
        png, argv = argv[1], argv[2:]
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        sys.stderr.write(__doc__)
        return 2
    arg = argv[0]
    req = json.loads(arg) if arg.lstrip().startswith("{") else {"op": arg}
    req.setdefault("id", "zg")
    host, port = os.environ.get("ZGUEST_ADDR", "127.0.0.1:5555").rsplit(":", 1)
    timeout = float(os.environ.get("ZG_TIMEOUT", "60"))
    buf = b""
    with socket.create_connection((host, int(port)), timeout=timeout) as s:
        s.sendall((json.dumps(req) + "\n").encode())
        while not buf.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
    resp = json.loads(buf.decode("utf-8", "replace"))
    if png and resp.get("png_b64"):
        with open(png, "wb") as f:
            f.write(base64.b64decode(resp["png_b64"]))
        resp["png_b64"] = "<%d bytes written to %s>" % (os.path.getsize(png), png)
    print(json.dumps(resp))
    return 0 if resp.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
